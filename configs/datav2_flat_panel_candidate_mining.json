{
  "target_subclass": "flat_rectangular_graphic_panels",
  "metadata_paths": [
    "data/metadata/abo/3dmodels.csv.gz",
    "data/metadata/abo/*.csv",
    "data/metadata/abo/*.csv.gz",
    "data/metadata/objaverse/*.csv",
    "data/metadata/objaverse/*.csv.gz",
    "data/metadata/objaverse/*.jsonl",
    "data/metadata/objaverse/*.jsonl.gz",
    "data/metadata/objaverse_xl/*.csv",
    "data/metadata/objaverse_xl/*.csv.gz",
    "data/metadata/objaverse_xl/*.jsonl",
    "data/metadata/objaverse_xl/*.jsonl.gz"
  ],
  "outputs": {
    "metadata_report_md": "outputs/phase2l/metadata_inventory/metadata_sources_report.md",
    "metadata_report_json": "outputs/phase2l/metadata_inventory/metadata_sources_report.json",
    "candidates_csv": "data/candidates/datav2_flat_panel_metadata_candidates.csv",
    "candidates_md": "data/candidates/datav2_flat_panel_metadata_candidates.md",
    "candidate_summary_json": "data/candidates/datav2_flat_panel_candidate_summary.json"
  },
  "positive_keywords": [
    "poster",
    "sign",
    "plaque",
    "wall art",
    "canvas",
    "framed",
    "frame",
    "print",
    "painting",
    "picture",
    "artwork",
    "board",
    "panel",
    "tile",
    "label",
    "package",
    "packaging",
    "box",
    "cover",
    "book cover",
    "decorative",
    "graphic",
    "logo"
  ],
  "negative_keywords": [
    "bottle",
    "can",
    "mug",
    "cup",
    "chair",
    "sofa",
    "table",
    "vehicle",
    "car",
    "truck",
    "character",
    "person",
    "human",
    "animal",
    "plant",
    "tree",
    "room",
    "scene",
    "building",
    "house",
    "sculpture",
    "statue",
    "transparent",
    "glass",
    "weapon"
  ],
  "technical_filters": {
    "prefer_file_extensions": [
      "glb",
      "gltf",
      "obj"
    ],
    "prefer_nonzero_texture_indicators": true,
    "prefer_nonzero_material_indicators": true,
    "prefer_single_object_or_low_object_count": true,
    "optional_min_file_size_bytes": null,
    "optional_max_file_size_bytes": null,
    "optional_min_face_count": null,
    "optional_max_face_count": null
  },
  "rank_weights": {
    "positive_keyword_score": 4.0,
    "negative_keyword_penalty": 5.0,
    "texture_indicator_score": 2.0,
    "material_indicator_score": 1.5,
    "file_format_score": 1.0,
    "geometry_sanity_score": 1.0,
    "source_priority_score": 0.5
  },
  "source_priority": {
    "abo": 1.0,
    "objaverse": 0.8,
    "objaverse_xl": 0.8,
    "unknown": 0.2
  },
  "abo_geometry_scoring": {
    "enabled": true,
    "candidate_source_files": [
      "data/metadata/abo/3dmodels.csv.gz"
    ],
    "auxiliary_source_files": [
      "data/metadata/abo/images.csv.gz"
    ],
    "min_textures": 1,
    "min_materials": 1,
    "max_meshes": 3,
    "min_faces": 500,
    "max_faces": 150000,
    "flatness_good_threshold": 0.12,
    "flatness_ok_threshold": 0.2,
    "aspect_min": 0.6,
    "aspect_max": 3.5,
    "thin_rod_penalty_aspect": 5.0,
    "weights": {
      "flatness_score": 4.0,
      "rectangular_aspect_score": 3.0,
      "texture_score": 2.0,
      "material_score": 1.5,
      "mesh_count_score": 1.0,
      "face_count_score": 1.0,
      "image_resolution_score": 0.5,
      "semantic_keyword_score": 1.0,
      "negative_keyword_penalty": 2.0
    }
  }
}
