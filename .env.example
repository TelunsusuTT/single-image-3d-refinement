#!/usr/bin/env bash

# External Hunyuan3D 2.1 checkout and official Paint-stage model weights.
export HUNYUAN3D_ROOT=/path/to/Hunyuan3D-2.1
# Set this only when the Paint source is not at ${HUNYUAN3D_ROOT}/hy3dpaint.
# export HUNYUAN3D_PAINT_SOURCE_ROOT=/path/to/Hunyuan3D-2.1/hy3dpaint

# Optional executable overrides used by the public workflow and Slurm launchers.
export PYTHON_BIN=python
export BLENDER_BIN=blender
